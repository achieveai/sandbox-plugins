/dist/
/build/
*.egg-info/

# OS files
Thumbs.db
.DS_Store

# Temporary files
*.tmp
*.temp
.cache/

# Local root-level MCP config (user-specific dev config for this repo itself).
# Anchored to the root so a plugin's own .mcp.json (a standard, trackable plugin
# component — see CLAUDE.md) is never silently dropped.
/.mcp.json

# Test coverage
coverage/
.nyc_output/
htmlcov/
*.cover

# Plugin development
*.mcpb
.mcp-build/

# Scratchpad - keep structure but ignore personal notes
scratchpad/**
!scratchpad/README.md

# Inspiration reference repos (not tracked in this repository)
inspirations/

# Auto detect text files and perform LF normalization
* text=auto

# Markdown files
*.md text eol=lf

# JSON files
*.json text eol=lf

# YAML files
*.yml text eol=lf
*.yaml text eol=lf

# Shell scripts
*.sh text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Vendored, byte-identical third-party bundle — never normalize line endings.
# provenance.json pins a SHA-256 of this exact file; EOL conversion would
# silently invalidate it on checkout (core.autocrlf) without changing behavior.
azure-devops/scripts/ado-cli.js binary
